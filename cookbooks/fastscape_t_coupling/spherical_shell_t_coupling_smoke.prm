include box_t_coupling_smoke.prm

set Output directory = output-spherical-shell-t-coupling-smoke

subsection Geometry model
  set Model name = spherical shell
  subsection Spherical shell
    set Inner radius  = 6350e3
    set Outer radius  = 6370e3
    set Opening angle = 90
  end
  subsection Initial topography model
    set Model name = zero topography
  end
end

subsection Mesh deformation
  set Mesh deformation boundary indicators = outer: fastscape surface evolution
  set Additional tangential mesh velocity boundary indicators = west, east
  subsection FastScape surface evolution
    set Box repetitions  = 32
    set T coupling width = 300e3
    set Initial relief   = 1000
    set Apply normal material velocity = false
  end
end

subsection Boundary velocity model
  set Tangential velocity boundary indicators = inner, west, east
end

subsection Boundary temperature model
  set Fixed temperature boundary indicators = inner, outer
end

subsection Gravity model
  set Model name = radial constant
  subsection Radial constant
    set Magnitude = 0
  end
end
