# Runtime smoke test for the two-dimensional FastScape C++ T coupling.
# ASPECT solves a 2-D tectonic section while FastScape evolves an x-y raster.
set Dimension                     = 2
set Use years instead of seconds = true
set End time                      = 2000
set Maximum time step             = 1000
set Nonlinear solver scheme       = no Advection, single Stokes
set Output directory              = output-box-t-coupling-smoke
set Pressure normalization        = no
set Surface pressure              = 0

subsection Geometry model
  set Model name = box
  subsection Box
    set X extent      = 100e3
    set Y extent      = 20e3
    set X repetitions = 4
  end
  subsection Initial topography model
    set Model name = function
    subsection Function
      set Function constants       = L=100e3
      set Function expression      = 1000*sin(pi*x/L)
      set Maximum topography value = 1000
    end
  end
end

subsection Mesh deformation
  set Mesh deformation boundary indicators = top: fastscape surface evolution
  set Additional tangential mesh velocity boundary indicators = left, right
  subsection FastScape surface evolution
    set Box repetitions                     = 8
    set Surface refinement level            = 0
    set Use T coupling in 2d                = true
    set T coupling width                    = 50000
    set T coupling reduction                = average
    set Surface transfer scheme             = conservative
    set Surface transfer neighbors          = 4
    set Landscape steps per geodynamic step = 2
    set Maximum landscape step              = 500
    set River incision coefficient          = 1e-5
    set Drainage area exponent              = 0.4
    set Slope exponent                      = 1
    set Hillslope diffusion coefficient     = 1e-2
    set Marine sediment transport coefficient = 100
    set Marine sediment porosity            = 0.4
    set Result interval                     = 1
    set Write visualization results         = true
  end
end

subsection Boundary velocity model
  set Tangential velocity boundary indicators = bottom, left, right
end

subsection Gravity model
  set Model name = vertical
  subsection Vertical
    set Magnitude = 0
  end
end

subsection Initial temperature model
  set List of model names = function
  subsection Function
    set Function expression = 0
  end
end

subsection Boundary temperature model
  set Fixed temperature boundary indicators = bottom, top
  set List of model names = initial temperature
end

subsection Material model
  set Model name = simple
  subsection Simple model
    set Reference density             = 1
    set Reference specific heat       = 1
    set Reference temperature         = 0
    set Thermal conductivity          = 1
    set Thermal expansion coefficient = 0
    set Viscosity                     = 1
  end
end

subsection Formulation
  set Formulation = Boussinesq approximation
end

subsection Mesh refinement
  set Initial global refinement          = 0
  set Initial adaptive refinement        = 0
  set Time steps between mesh refinement = 0
end

subsection Postprocess
  set List of postprocessors = topography
end
